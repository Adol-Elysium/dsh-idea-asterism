{
  "name": "dsh-idea-asterism",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "思维星图（Idea Asterism）是一款用于 DeepSeek Harness 的三维思维风暴插件。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "ai.js",
    "store.js",
    "core.cjs",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "yaml-reader.cjs",
    "CHANGELOG.md",
    "DEVELOPMENT.md",
    "docs/tidal-library-star-map.png",
    "LICENSE"
  ],
  "engines": {
    "dsh": "0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node tools/build.mjs",
    "check:host": "node tools/check-host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": []
    }
  },
  "displayName": "思维星图 / Idea Asterism",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adol-Elysium/dsh-idea-asterism.git"
  }
}
